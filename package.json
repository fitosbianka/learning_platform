{
  "name": "learning-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
